# Neon Postgres (orders + catalog categories/products/tools)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Public site URL (required for Paystack callback + Telegram webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (card + mobile money)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_CURRENCY=NGN
NEXT_PUBLIC_USD_TO_PAYSTACK_RATE=1600

# Crypto deposit addresses
NEXT_PUBLIC_CRYPTO_USDC_ADDRESS=
NEXT_PUBLIC_CRYPTO_ETH_ADDRESS=
NEXT_PUBLIC_CRYPTO_SOL_ADDRESS=
NEXT_PUBLIC_CRYPTO_LTC_ADDRESS=

# Public site contact (Connect page)
NEXT_PUBLIC_SUPPORT_EMAIL=info@dvtechnologies.xyz
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/dvtechnologies
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Telegram shop bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: channel/group chat id for product announcements
TELEGRAM_ANNOUNCE_CHAT_ID=

# Admin dashboard (/admin)
ADMIN_PASSWORD=bytestore-admin

# UploadThing (product/tool images) — from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=
